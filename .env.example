# =========================================================================
# CLAIM2CAR CONNECT™ — LOCAL DEVELOPMENT ENVIRONMENT MAPPINGS
# =========================================================================

# --- GLOBAL CONFIG ---
CORS_ORIGINS=*
PORT=8000

# --- DATABASE AND CACHING ---
# Inside Docker, use "mongodb" and "redis" as the hostname corresponding to the service names.
MONGO_URL=mongodb://mongodb:27017
DB_NAME=claim2car_db
REDIS_URL=redis://redis:6379/0

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=dev-super-secret-key-change-in-production-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXP_HOURS=24

# --- THIRD-PARTY INTELLIGENCES & INTEGRATION KEYS ---
# xAI Grok API Key (Used as visual consensus orchestrator)
XAI_API_KEY=xai_grok_api_key_placeholder

# Transactional Email Dispatch (Resend API)
RESEND_API_KEY=resend_api_key_placeholder

# --- SYSTEM FEATURE DECOUPLES & WRAPPERS ---
# Notary Adapter Anchor Strategy: none | mock_sandbox | polygon | base
ANCHOR_ADAPTER=none
ANCHOR_POLYGON_RPC_URL=https://polygon-rpc.com
ANCHOR_POLYGON_PRIVATE_KEY=your_polygon_wallet_private_key
