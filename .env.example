# CLAIM2CAR FAOS - Environment Configuration Template
# IMPORTANT: Never commit actual secrets to this file.
# Load actual values from HashiCorp Vault or GitHub Secrets at runtime.

# ═══════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# NOTE: These are examples only. Real credentials stored in Vault.
DATABASE_URL=postgresql://postgres:PLACEHOLDER@postgres:5432/claim2car
MONGODB_URL=mongodb://mongo:PLACEHOLDER@mongodb:27017/claim2car_events
REDIS_URL=redis://:PLACEHOLDER@redis:6379/0

# ═══════════════════════════════════════════════════════════════
# VAULT / SECRETS MANAGEMENT
# ═══════════════════════════════════════════════════════════════
VAULT_ENABLED=true
VAULT_ADDR=https://vault.claim2car.com
VAULT_TOKEN=VAULT_TOKEN_LOADED_AT_RUNTIME
VAULT_SECRET_PATH=secret/claim2car

# ═══════════════════════════════════════════════════════════════
# SECURITY & CRYPTOGRAPHY
# ═══════════════════════════════════════════════════════════════
ENV=production
DEBUG=false
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY=LOADED_FROM_VAULT

# ═══════════════════════════════════════════════════════════════
# CORS & NETWORKING
# ═══════════════════════════════════════════════════════════════
CORS_ORIGINS=*.claim2car.com,track.claim2car.com
ALLOWED_HOSTS=api.claim2car.com,track.claim2car.com

# ═══════════════════════════════════════════════════════════════
# THIRD-PARTY API INTEGRATIONS
# ═══════════════════════════════════════════════════════════════
NHTSA_VPIC_ENDPOINT=https://vpic.nhtsa.dot.gov/api/vehicles
SQUARE_API_KEY=LOADED_FROM_VAULT
RESEND_API_KEY=LOADED_FROM_VAULT
POLYGON_API_KEY=LOADED_FROM_VAULT

# ═══════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════
ENABLE_WASM_DARCI=true
ENABLE_BATCH_SETTLEMENT=true
ENABLE_WEBSOCKET_ROUTING=true
ENABLE_BLOCKCHAIN_ANCHORING=true

# ═══════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=info
LOG_FORMAT=json
